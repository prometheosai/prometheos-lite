{
  "schema": "autonomous-verification-policy/2",
  "approved_patterns": [
    {
      "id": "python-unittest-quiet",
      "argv": ["python", "-m", "unittest", "-q"],
      "match": "exact"
    },
    {
      "id": "python3-unittest-quiet",
      "argv": ["python3", "-m", "unittest", "-q"],
      "match": "exact"
    },
    {
      "id": "python-unittest-discover",
      "argv": ["python", "-m", "unittest", "discover", "-s", "tests", "-v"],
      "match": "exact"
    },
    {
      "id": "git-diff-check",
      "argv": ["git", "diff", "--check"],
      "match": "exact"
    }
  ],
  "max_commands": 24,
  "default_timeout_seconds": 600,
  "max_timeout_seconds": 1800,
  "max_output_bytes": 1048576,
  "read_chunk_bytes": 4096,
  "process_tree_termination_guaranteed": false,
  "no_shell": true,
  "allowed_environment_keys": ["PATH", "PATHEXT", "SYSTEMROOT", "WINDIR", "HOME", "LANG", "LC_ALL", "TMP", "TEMP", "TMPDIR", "PYTHONDONTWRITEBYTECODE", "PYTHONIOENCODING"],
  "sandbox": {
    "mode": "unavailable",
    "require_sandbox": false,
    "filesystem_isolation_enforced": false,
    "network_isolation_enforced": false
  },
  "required_negative_control_ids": [],
  "note": "Argument templates are the authorization boundary. This is NOT an OS sandbox; no filesystem, network or privilege isolation is claimed."
}
